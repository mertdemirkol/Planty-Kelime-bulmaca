    public void veriokuma(int deger) {
        DatabaseReference databaseReference = FirebaseDatabase.getInstance().getReference("bitkinem/bitkigelenveri");

        databaseReference.addListenerForSingleValueEvent(new ValueEventListener() {
            @Override
            public void onDataChange(@NonNull DataSnapshot snapshot) {
                if (snapshot.exists()) {
                    // Eğer veri varsa, değeri al
                   gelenveridegeri = snapshot.getValue(Integer.class);
                    System.out.println("Bitkigelenveri: " + gelenveridegeri);
                     int gonder = deger+gelenveridegeri;
                    databaseReference.setValue(gonder);
                } else {
                    // Veri yoksa yapılacak işlemler
                    System.out.println("Veri bulunamadı.");
                }
            }

            @Override
            public void onCancelled(@NonNull DatabaseError error) {
                // Hata durumunda yapılacak işlemler
            }
        });
    }

    public void toprakdegerinemi() {
        DatabaseReference databaseReference = FirebaseDatabase.getInstance().getReference("bitkinem/topraknemi");

        databaseReference.addListenerForSingleValueEvent(new ValueEventListener() {
            @Override
            public void onDataChange(@NonNull DataSnapshot snapshot) {
                if (snapshot.exists()) {
                    // Eğer veri varsa, değeri alabilirsiniz
                    int topraknemi    = snapshot.getValue(Integer.class);
                   int degisken=1023-topraknemi;
                   binding.progressBar2.setProgress(degisken);
                    System.out.println("Bitkigelenveri tprak nemi: " + topraknemi);
                  if (0<degisken &&degisken<300){
                      binding.progbardurumu.setText(R.string.kuru);

                  }
                  else if ( 301<degisken && degisken<800) {
                          binding.progbardurumu.setText(R.string.orta);
                    } else if (801<degisken  && degisken<1024) {
                      binding.progbardurumu.setText(R.string.islak);

                  }


                } else {
                    // Veri yoksa yapılacak işlemler
                    System.out.println("Veri bulunamadı.");
                }
            }

            @Override
            public void onCancelled(@NonNull DatabaseError error) {
                // Hata durumunda yapılacak işlemler
            }
        });
    }
    private String getLastLoginDate() {
        SharedPreferences sharedPreferences = getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE);
        return sharedPreferences.getString(KEY_LAST_LOGIN_DATE, "");
    }

    private void saveLastLoginDate(String currentDate) {
        SharedPreferences sharedPreferences = getSharedPreferences(PREF_NAME, Context.MODE_PRIVATE);
        SharedPreferences.Editor editor = sharedPreferences.edit();
        editor.putString(KEY_LAST_LOGIN_DATE, currentDate);
        editor.apply();
    }

    private String getCurrentDate() {
        SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd", Locale.getDefault());
        return sdf.format(new Date());
    }

