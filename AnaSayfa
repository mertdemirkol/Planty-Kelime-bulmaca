    }

    public void odullureklamyukleme(){
        AdRequest adRequest= new AdRequest.Builder().build();
        RewardedAd.load(Anasayfa.this, "ca-app-pub-9753071382932184/2312175205", adRequest, new RewardedAdLoadCallback() {
            @Override
            public void onAdFailedToLoad(@NonNull LoadAdError loadAdError) {
                mrewardedAd=null;
                Toast.makeText(Anasayfa.this, R.string.hatamesaji, Toast.LENGTH_SHORT).show();
            }

            @Override
            public void onAdLoaded(@NonNull RewardedAd rewardedAd) {
               mrewardedAd=rewardedAd;
               mrewardedAd.setFullScreenContentCallback(new FullScreenContentCallback() {
                   @Override
                   public void onAdDismissedFullScreenContent() {
